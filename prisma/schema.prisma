generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"  
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       String @id @default(uuid())
  nome    String
  email    String @unique
  password String
  telefone String
  tipoPessoa TipoPessoa
  cargo   String
  funcao  String
  role     Role

  @@map("usuarios")
}

model Empresa {
  id       String @id @default(uuid())
  nome     String
  email    String @unique
  cnpj     String @unique
  endereco String
  telefone String
  plano    String

  @@map("empresas")
}

enum Role {
  USER
  ADMIN
}

enum TipoPessoa {
  FISICA
  JURIDICA
}