generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id         String     @id @default(uuid())
  nome       String
  email      String     @unique
  password   String
  telefone   String
  tipoPessoa TipoPessoa
  cargo      String?
  funcao     String?
  role       Role
  plano      String?
  empresas   Empresa[]

  @@map("usuarios")
}

model Empresa {
  id        String  @id @default(uuid())
  nome      String
  email     String  @unique
  cnpj      String  @unique
  endereco  String
  telefone  String
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("empresas")
}

model DeducoesReceitaBruta {
  id                          String @id @default(uuid())
  tributosSobreVendasServicos Float
  tributosSobreFaturamento    Float

  @@map("deducoes_receita_bruta")
}

enum Role {
  USER
  ADMIN
}

enum TipoPessoa {
  FISICA
  JURIDICA
}
